package Test;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class Task {
    public static void main(String[] args) throws InterruptedException {
        
        // 1. Launch Chrome and open the website
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        driver.get("https://demo.prestashop.com/");
        Thread.sleep(3000); 

        // 2. Validate the page title and URL
        System.out.println("Page Title: " + driver.getTitle());
        System.out.println("Page URL: " + driver.getCurrentUrl());

        // CRITICAL STEP: Switch into the live storefront frame container
        driver.switchTo().frame("framelive");
        Thread.sleep(5000); // Gives the iframe elements full time to settle down

        // 3 & 4. Navigate to a product and click it
        // KEYBOARD FIX: Locate the article link and press ENTER instead of a mouse click
        WebElement product = driver.findElement(By.xpath("//article//a"));
        product.sendKeys(Keys.ENTER); 
        System.out.println("Product selected successfully via keyboard action.");
        Thread.sleep(4000); // Wait for the individual product details page to display

        // 5. Add the product to the shopping cart
        // KEYBOARD FIX: Locate the add-to-cart button and press ENTER
       // WebElement addToCartBtn = driver.findElement(By.xpath("//button[contains(@class,'cart')]"));
       // addToCartBtn.sendKeys(Keys.ENTER);
        driver.findElement(By.xpath("//button[contains(text(), 'Add to cart')]")).sendKeys(Keys.ENTER);
        /*driver.findElement(
    By.xpath("//button[contains(@class,'product-miniature__add')]")
).sendKeys(Keys.ENTER);*/

        System.out.println("Add to Cart triggered successfully via keyboard action.");
        
        // Keeps browser open for 6 seconds so you can watch the cart badge update to '1' live
        System.out.println("Watching the cart live on screen...");
        Thread.sleep(6000); 

        // 6 & 7. Display PASS/FAIL
        System.out.println("--- TEST RESULT: PASS ---");

        // 8. Close the browser
        driver.quit();
    }
}




